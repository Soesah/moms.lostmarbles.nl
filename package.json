{
  "name": "moms.lostmarbles.nl",
  "version": "0.1.0",
  "private": true,
  "description": "Moms recipe website",
  "author": {
    "name": "Carl Giesberts",
    "email": "carl@front-crafter.nl",
    "url": "https://www.front-crafter.nl"
  },
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "yarn build && gcloud app deploy app.yaml --project moms-lost-marbles -q --no-cache",
    "app": "go run moms.go",
    "deploy:cron": "gcloud app deploy cron.yaml --project moms-lost-marbles -q",
    "major": "./bin/deploy.sh major",
    "minor": "./bin/deploy.sh minor",
    "patch": "./bin/deploy.sh patch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "nosleep.js": "^0.12.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.7.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "less": "^4.9.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vue-tsc": "^3.3.14"
  },
  "prettier": {
    "arrowParens": "always",
    "trailingComma": "all",
    "semi": true,
    "singleQuote": true
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
